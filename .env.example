# 复制这个文件为 .env,然后填入你的真实 key
#
# 注意:这个文件会提交到 git,是给别人看的模板。
# 永远只放占位符,不要放真实 key。真实 key 放 .env(.env 已被 .gitignore 忽略)。

DEEPSEEK_API_KEY=sk-你的key写在这里
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 默认模型:deepseek-flash(DeepSeek V4.1 Flash,当前推荐的现役模型)
# 可选:deepseek-v4-pro(更强,更贵,官方只建议既有集成沿用)
# 注意:deepseek-chat / deepseek-reasoner 已于 2026-07-24 停用,用它们会直接报错
DEFAULT_MODEL=deepseek-flash
